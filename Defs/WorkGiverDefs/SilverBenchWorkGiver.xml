<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    银加工台和银矿场是同一个问题：原版账单派活器（制作）在 1.7 里对这两个建筑都返回空，
    所以右键没有"干活"选项、小人也不来。
    这里给银加工台单独注册一个挂在"制作"下面的派活器，内部复用银矿那套自己拼任务的做法。
  -->
  <WorkGiverDef>
    <defName>DshEco_RefineSilverBill</defName>
    <giverClass>DshEconomy.WorkGiver_SilverBench</giverClass>
    <workType>Crafting</workType>
    <priorityInType>55</priorityInType>
    <verb>精炼</verb>
    <gerund>精炼中</gerund>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
