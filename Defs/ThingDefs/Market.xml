<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="FurnitureBase">
    <defName>DshEco_Market</defName>
    <label>市场摊位</label>
    <description>殖民地的对外售卖点。放进这里的商品会被居民优先购买；钱要等居民真正把东西拿到手上才算进账。容量 100 件，满了会把多出来的货退到地上。</description>
    <thingClass>DshEconomy.Building_Market</thingClass>
    <tickerType>Normal</tickerType>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <category>Building</category>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>10</Mass>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <WoodLog>300</WoodLog>
    </costList>
    <altitudeLayer>ItemImportant</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.5</fillPercent>
    <graphicData>
      <texPath>Things/Building/Misc/DshEco_Market</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2100</uiOrder>
    <placeWorkers>
      <li>DshEconomy.PlaceWorker_MarketSpacing</li>
    </placeWorkers>
    <hasInteractionCell>false</hasInteractionCell>
    <rotatable>false</rotatable>
    <building>
      <maxItemsInCell>25</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
          <disallowedCategories>
            <li>Chunks</li>
            <li>Plants</li>
            <li>Buildings</li>
          </disallowedCategories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
            <li>Items</li>
            <li>Weapons</li>
            <li>Apparel</li>
            <li>BodyParts</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>
</Defs>
